# Copy to .env.local for local defaults. Leave secrets empty to use sample data.
# The firewall configuration API uses a bearer API key (Administration > API access).
# SOPHOS_FIREWALL_PASSWORD is that key. The API user is recorded on import comments.

SOPHOS_FIREWALL_URL=https://firewall.example:4444
SOPHOS_FIREWALL_USER=
SOPHOS_FIREWALL_PASSWORD=
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
SOPHOS_TENANT_ID=
# Optional. Leave blank to use the data region from Who am I.
# eu01 eu02 us01 us03 ca01 au01 jp01 in01 br01 ae01
SOPHOS_DATA_REGION=
